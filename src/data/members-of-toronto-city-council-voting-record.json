{"help": "https://ckan0.cf.opendata.inter.prod-toronto.ca/api/3/action/help_show?name=package_show", "success": true, "result": {"author": "clerk@toronto.ca", "author_email": "clerk@toronto.ca", "creator_user_id": "329e1506-b545-4fc7-a4ea-e614f220eea7", "dataset_category": "Table", "date_published": "2019-07-23 17:43:02.171489", "excerpt": "Access Voting-Record Reporting data for Members of Toronto City Council.", "formats": ["CSV", "XML", "JSON", "TXT"], "id": "7f5232d6-0d2a-4f95-864a-417cbf341cc4", "information_url": "https://www.toronto.ca/city-government/council/council-committee-meetings/", "is_retired": false, "isopen": false, "last_refreshed": "2026-11-07 18:10:02.715889", "license_id": "open-government-licence-toronto", "license_title": "open-government-licence-toronto", "maintainer": null, "maintainer_email": "clerk@toronto.ca", "metadata_created": "2022-03-10T18:59:45.919524", "metadata_modified": "2026-11-07T18:10:04.590805", "name": "members-of-toronto-city-council-voting-record", "notes": "This dataset includes the Voting record for Members of Toronto City Council at legislative meetings that are supported but the City Clerk. \r\n\r\nFor official definitions and procedure by-law information, refer to the [City of Toronto Municipal Code, Chapter 27, Council Procedures](http://www.toronto.ca/legdocs/municode/1184_027.pdf) \r\n\r\n**Description of the data**\r\n\r\n- The vote record data for a meeting becomes available when the minutes for a meeting have been published.\r\n\r\n- Since 2010, recorded votes have been made available in this downloadable format (not just in the published minutes). \r\n\r\n- Votes generated in the report are recorded votes only. Under Article 12 of the Council Procedures by-law, the City Clerk may be asked to record a vote for specific types of motions that are made by members during a meeting. When requested, votes are recorded as \"Yes\", \"No\" or \"Absent\"\r\n\r\n_\"Absent\" can also indicate that a member chose not to participate in a vote because they declared an interest under the Municipal Conflict of Interest Act._\r\n\r\n\r\n \r\n", "num_resources": 21, "num_tags": 0, "organization": {"id": "6ed95875-f7d6-4200-964c-91024cc49cba", "name": "city-of-toronto", "title": "City of Toronto", "type": "organization", "description": "", "image_url": "", "created": "2022-03-10T15:38:51.044746", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_division": "City Clerk's Office", "owner_email": "clerk@toronto.ca", "owner_org": "6ed95875-f7d6-4200-964c-91024cc49cba", "private": false, "refresh_rate": "As available", "state": "active", "title": "Members of Toronto City Council - Voting Record", "topics": ["City government"], "type": "dataset", "version": null, "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2023-01-09T20:51:03.717717", "datastore_active": true, "datastore_cache": {"CSV": "c4feb78c-c867-42a9-b803-7c6d859df969", "XML": "aa0e8c09-f40f-4147-9093-737c1a73fba3", "JSON": "c29485c5-3ebe-4926-99d9-539b138b0fe0"}, "datastore_cache_last_update": "2026-11-07T18:10:03.639277", "extract_job": "Airflow - files_to_datastore.py - members-of-toronto-city-council-voting-record", "format": "CSV", "hash": "", "id": "55ead013-2331-4686-9895-9e8145b94189", "is_preview": true, "last_modified": "2023-01-19T15:32:52.000458", "metadata_modified": "2026-11-07T18:10:04.144855", "mimetype": "text/csv", "mimetype_inner": null, "name": "member-voting-record-2022-2026", "package_id": "7f5232d6-0d2a-4f95-864a-417cbf341cc4", "package_name_or_id": "members-of-toronto-city-council-voting-record", "position": 0, "record_count": 46815, "resource_type": null, "size": null, "state": "active", "url": "https://ckan0.cf.opendata.inter.prod-toronto.ca/datastore/dump/55ead013-2331-4686-9895-9e8145b94189", "url_type": "datastore", "vertex_count": null}, {"cache_last_updated": null, "cache_url": null, "created": "2022-09-12T14:38:11.226846", "datastore_active": true,